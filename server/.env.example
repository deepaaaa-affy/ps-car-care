PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/pscarcare
CLIENT_URL=http://localhost:5173

# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# First admin (used once by: npm run seed:admin). Password: at least 12 characters.
# Remove ADMIN_PASSWORD from this file after the admin has been created.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email for staff invites (optional: without it the admin panel shows the invite link to send yourself)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
